# Bullet – settings for the web server (Apache, e.g. IONOS)

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  # The page, the service worker, the manifest and the icons are checked on
  # every start, so a new version arrives at once (IONOS would otherwise keep
  # images for four weeks).
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$|^(apple-touch-icon|icon-[a-z0-9-]+)\.png$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
<IfModule mod_headers.c>
  # Built files carry a fingerprint in their name and never change.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Not public: the data, the server code and its settings.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pages always over https: Google sends the sign-in back only to the https
  # address. (Only GET and HEAD: a redirect would turn a POST into a GET.)
  # The path is taken from the request line as it came in (on IONOS
  # REQUEST_URI of a folder, "/bullet/", reads as "/"); the query is added by
  # Apache itself.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s+(/[^?\s]*)
  RewriteRule ^ https://%{HTTP_HOST}%2 [R=301,L,NE]
  RewriteRule (^|/)(bullet-daten|lib|\.git|\.github)(/|$) - [F,L]
  RewriteRule (^|/)bullet-config\.php$ - [F,L]
  RewriteRule \.(md|lock|tmp[0-9a-f]*)$ - [F,L]
</IfModule>
<IfModule mod_authz_core.c>
  <Files "bullet-config.php">
    Require all denied
  </Files>
</IfModule>

Options -Indexes
